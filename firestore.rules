rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções Auxiliares
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'devalefdias44@gmail.com' ||
         request.auth.token.admin == true || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'master_admin']);
    }

    // Coleção Usuários
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlocked']))) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Coleção Anúncios
    match /ads/{adId} {
      // Qualquer um pode ler anúncios ativos na sua cidade
      allow read: if resource.data.status == 'active' || isOwner(resource.data.userId) || isAdmin();

      // Criação de anúncio pelo usuário autenticado (status inicial obrigatório: rascunho ou aguardando pagamento)
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['draft', 'pending_payment'] &&
        request.resource.data.title.size() >= 5 &&
        request.resource.data.price >= 0;

      // Usuário só edita seus próprios anúncios (e não pode alterar expiração nem forçar status de ativo sem pagamento)
      allow update: if (isOwner(resource.data.userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['expiresAt', 'planId', 'isFeatured']) &&
                       (request.resource.data.status in ['sold', 'removed', resource.data.status])) 
                    || isAdmin();

      // Exclusão por proprietário ou admin
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Transações de Pagamento Pix (Somente leitura do próprio usuário, gravação/confirmação restrita)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Confirmação de status de pagamento reservada para backend / admin
      allow update, delete: if isAdmin();
    }

    // Denúncias de Anúncios
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Cidades e Categorias
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
